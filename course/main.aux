\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Current-task success rate across the 10-task $\alpha $ sequence (carryover). Task boundaries are marked by dashed lines. \textsc  {Hace}{} (teal) and \textsc  {Hace}{}+EWC (vermillion) consistently recover at task transitions, while Task-Only (amber) and EWC (mauve) collapse on later tasks. Background lines show remaining agents. Mean $\pm \,1\sigma $ across 10 seeds.}}{4}{figure.caption.8}\protected@file@percent }
\newlabel{fig:learning}{{1}{4}{Current-task success rate across the 10-task $\alpha $ sequence (carryover). Task boundaries are marked by dashed lines. \hace {} (teal) and \hace {}+EWC (vermillion) consistently recover at task transitions, while Task-Only (amber) and EWC (mauve) collapse on later tasks. Background lines show remaining agents. Mean $\pm \,1\sigma $ across 10 seeds}{figure.caption.8}{}}
