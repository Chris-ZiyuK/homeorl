\@writefile{toc}{\contentsline {paragraph}{生存可行性失效是一种独立的、被忽视的失效模式。}{6}{paragraph*.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 10 任务 $\alpha $ 序列（继承模式）序列末成功率（智能体 $\times $ 任务）（图中文字为英文）。颜色越深成功率越高。\textsc  {Hace}{}+EWC（底行）平均性能最高；\textsc  {Hace}{}（C）在 Gauntlet Refuel 上取得最强的非先知性能。}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:heatmap}{{3}{7}{10 任务 $\alpha $ 序列（继承模式）序列末成功率（智能体 $\times $ 任务）（图中文字为英文）。颜色越深成功率越高。\hace {}+EWC（底行）平均性能最高；\hace {}（C）在 Gauntlet Refuel 上取得最强的非先知性能。}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 重置（左）与继承（右）模式下的最终评估（图中文字为英文）。重置模式下所有智能体表现相当；继承模式下仅任务奖励（琥珀色）退化而 \textsc  {Hace}{}（青色）保持性能。这一差异支持生存可行性失效是主要解释：当边界能量被重置时，同样的任务序列与学习设置下性能得以恢复。}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:collapse}{{4}{7}{重置（左）与继承（右）模式下的最终评估（图中文字为英文）。重置模式下所有智能体表现相当；继承模式下仅任务奖励（琥珀色）退化而 \hace {}（青色）保持性能。这一差异支持生存可行性失效是主要解释：当边界能量被重置时，同样的任务序列与学习设置下性能得以恢复。}{figure.4}{}}
